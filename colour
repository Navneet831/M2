    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F0F2F5; color: #111827; overflow-x: hidden; transition: background-color 0.3s, color 0.3s; }
        .dark body { background-color: #0A0A0A; color: #F3F4F6; }
        
        /* Desktop era scrollbar prohibition */
        ::-webkit-scrollbar { width: 0px; background: transparent; }
        
        .color-card {
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s, filter 0.2s;
        }
        .color-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            z-index: 10;
        }
        .color-card:active { transform: translateY(0px) scale(0.98); }

        /* Intersection Toggle Animation */
        .toggle-icon { transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55); }
        .toggle-icon.rotated { transform: rotate(180deg); }
    </style>
</head>
<body class="antialiased">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo, useCallback } = React;

        // --- CORE MATH & CONTRAST LOGIC (Hedge Fund Rigor) ---
        
        // Convert HEX to RGB
        const hexToRgb = (hex) => {
            let c = hex.substring(1);
            if (c.length === 3) c = c.split('').map(x => x + x).join('');
            return {
                r: parseInt(c.substring(0, 2), 16),
                g: parseInt(c.substring(2, 4), 16),
                b: parseInt(c.substring(4, 6), 16)
            };
        };

        // Calculate Relative Luminance (WCAG Formula)
        const getLuminance = (r, g, b) => {
            let [rs, gs, bs] = [r/255, g/255, b/255].map(c => 
                c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4)
            );
            return 0.2126 * rs + 0.7152 * gs + 0.0722 * bs;
        };

        // Calculate Contrast Ratio
        const getContrastRatio = (l1, l2) => {
            const lighter = Math.max(l1, l2);
            const darker = Math.min(l1, l2);
            return (lighter + 0.05) / (darker + 0.05);
        };

        // Determine optimal text color (Black or White) based on WCAG contrast
        const getOptimalTextColor = (hex) => {
            const rgb = hexToRgb(hex);
            const lum = getLuminance(rgb.r, rgb.g, rgb.b);
            const lumWhite = getLuminance(255, 255, 255);
            const lumBlack = getLuminance(17, 24, 39); // Tailwind gray-900

            const contrastWhite = getContrastRatio(lumWhite, lum);
            const contrastBlack = getContrastRatio(lum, lumBlack);

            return contrastWhite > contrastBlack ? '#FFFFFF' : '#111827';
        };

        // Legacy Clipboard execution due to iFrame CORS/Permissions restrictions
        const copyToClipboard = (text) => {
            const el = document.createElement('textarea');
            el.value = text;
            el.setAttribute('readonly', '');
            el.style.position = 'absolute';
            el.style.left = '-9999px';
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
        };

        // --- ICONS ---
        const Icon = ({ name, size=20, className="" }) => {
            const icons = {
                'moon': <svg className={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>,
                'sun': <svg className={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>,
                'copy': <svg className={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>,
                'check': <svg className={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            };
            return icons[name] || null;
        };

        // --- DATASET (Approximated from user prompt) ---
        const colorData = [
            { group: "Group 1", colors: [
                { name: "calming purple", hex: "#9B84B8" }, { name: "quiet Abyss", hex: "#0B101E" },
                { name: "perfect peach", hex: "#FFDCB8" }, { name: "Meski black", hex: "#0F1110" },
                { name: "electicity blue", hex: "#0FF0FC" }, { name: "Dark Sapphire", hex: "#0F1E38" },
                { name: "macadamia beige", hex: "#F0E0C8" }, { name: "fence green", hex: "#3B5E45" },
                { name: "fine turquoise", hex: "#48CED9" }, { name: "stellar explorer", hex: "#1B2838" },
                { name: "exotic summer", hex: "#FF7A59" }, { name: "extreme burgundy", hex: "#4A0404" },
                { name: "shimmer pearl", hex: "#FDFBF7" }, { name: "rich maroon", hex: "#6A0C0B" }
            ]},
            { group: "Group 2", colors: [
                { name: "Soft yellow green", hex: "#D5E59B" }, { name: "deep muted green", hex: "#2B4231" },
                { name: "neon green", hex: "#39FF14" }, { name: "chrysocolla blue", hex: "#2A8F9D" },
                { name: "mutated blue green", hex: "#4A787A" }, { name: "fresh green", hex: "#69D025" },
                { name: "reddish pink", hex: "#FF6B8B" }, { name: "pale yellow", hex: "#FFFFBF" }
            ]},
            { group: "Group 3", colors: [
                { name: "bright vibrant cyan", hex: "#00FFFF" }, { name: "deep navy blue", hex: "#000080" },
                { name: "lavender purple", hex: "#967BB6" }, { name: "warm pastel yellow", hex: "#FDFD96" },
                { name: "dark slate grey", hex: "#2F4F4F" }, { name: "antique ruby", hex: "#841B2D" },
                { name: "bistre", hex: "#3D2B1F" }, { name: "brown sugar", hex: "#AF6E4D" },
                { name: "thistle", hex: "#D8BFD8" }, { name: "liberty", hex: "#545AA7" },
                { name: "tan", hex: "#D2B48C" }, { name: "liver", hex: "#534B4F" },
                { name: "talismanic teal", hex: "#006D5B" }, { name: "almond roca", hex: "#EADDCD" },
                { name: "transparent yellow", hex: "#F4F098" }, { name: "cocoa dark brown", hex: "#32170B" }
            ]},
            { group: "Group 4", colors: [
                { name: "steel grey", hex: "#71797E" }, { name: "powder blue", hex: "#B0E0E6" },
                { name: "sandswip", hex: "#F5E7A2" }, { name: "coconut cream", hex: "#F8F4E6" },
                { name: "orchid", hex: "#DA70D6" }, { name: "camellia", hex: "#F67381" },
                { name: "magnolia", hex: "#F8F4FF" }, { name: "umber", hex: "#635147" },
                { name: "marble", hex: "#F2F0E6" }, { name: "apricot", hex: "#FBCEB1" },
                { name: "mango", hex: "#FFC324" }, { name: "pomegranate", hex: "#C0392B" },
                { name: "harbor", hex: "#30415D" }, { name: "glacier", hex: "#78B1BF" },
                { name: "pollen", hex: "#EEEEAA" }
            ]},
            { group: "Group 5", colors: [
                { name: "pickele green", hex: "#194225" }, { name: "glaucous", hex: "#6082B6" },
                { name: "pink pearl", hex: "#E7ACCF" }, { name: "sapphire", hex: "#0F52BA" },
                { name: "turmeric", hex: "#FFC000" }, { name: "green pea", hex: "#1D5921" },
                { name: "rasberry", hex: "#E30B5D" }, { name: "lemonade", hex: "#F8C1CC" },
                { name: "oak", hex: "#4F301F" }, { name: "olive", hex: "#808000" },
                { name: "sage", hex: "#BCBB8E" }, { name: "ivory", hex: "#FFFFF0" },
                { name: "teracotta", hex: "#E2725B" }, { name: "honey", hex: "#FFBD31" },
                { name: "sand", hex: "#C2B280" }
            ]},
            { group: "Group 6", colors: [
                { name: "white smoke", hex: "#F5F5F5" }, { name: "wine", hex: "#722F37" },
                { name: "double teal", hex: "#006666" }, { name: "lemon yellow", hex: "#FFF44F" },
                { name: "robbin egg blue", hex: "#00CCCC" }, { name: "black olive", hex: "#3B3C36" },
                { name: "persian pink", hex: "#F77FBE" }, { name: "lavender pink", hex: "#FBAED2" },
                { name: "platinum", hex: "#E5E4E2" }, { name: "photo blue", hex: "#9EB9D4" }
            ]},
            { group: "Group 7", colors: [
                { name: "misty blue", hex: "#A0AFCE" }, { name: "gun metal grey", hex: "#53565B" },
                { name: "creamy avocado", hex: "#C0E181" }, { name: "french blue", hex: "#0072BB" },
                { name: "plum wine", hex: "#5A3147" }, { name: "butter cream", hex: "#EFE2B4" },
                { name: "maroon", hex: "#800000" }
            ]},
            { group: "Group 8", colors: [
                { name: "Midnight orchid", hex: "#4D1A53" }, { name: "celadon court", hex: "#B8D8BE" },
                { name: "indigo atoll", hex: "#1D315C" }, { name: "horizon blue", hex: "#8FB8DE" },
                { name: "warm cement", hex: "#B5B2A8" }, { name: "ash white", hex: "#F2F0ED" }
            ]},
            { group: "Group 9", colors: [
                { name: "Carbon black", hex: "#1C1C1C" }, { name: "bone", hex: "#E3DAC9" },
                { name: "rosy copper", hex: "#C87661" }, { name: "pumpkin spice", hex: "#C96222" },
                { name: "Beige", hex: "#F5F5DC" }, { name: "deep mocha", hex: "#4A3028" },
                { name: "vibrant coral", hex: "#FF5E4D" }, { name: "albaster grey", hex: "#ECEAE4" },
                { name: "soft linen", hex: "#F2ECE1" }, { name: "dark goldernrod", hex: "#B8860B" },
                { name: "emeral spring", hex: "#2ECC71" }, { name: "electric lime", hex: "#CCFF00" },
                { name: "jet black", hex: "#0A0A0A" }, { name: "aero blue", hex: "#C0E8D5" },
                { name: "pelorous", hex: "#3EABBC" }, { name: "graphite", hex: "#383838" },
                { name: "darknude", hex: "#CCAB95" }, { name: "silver pink", hex: "#C4AEAE" },
                { name: "antique bronze", hex: "#665D1E" }
            ]},
            { group: "Group 10", colors: [
                { name: "ochre", hex: "#CC7722" }, { name: "FLoral white", hex: "#FFFAF0" },
                { name: "Corn silk", hex: "#FFF8DC" }, { name: "rose Ebony", hex: "#674846" },
                { name: "Midnight green", hex: "#004953" }, { name: "tea green", hex: "#D0F0C0" },
                { name: "Lavender Bluch", hex: "#FFF0F5" }, { name: "claret", hex: "#7F1734" },
                { name: "night SKY", hex: "#1A1A2E" }, { name: "Blue SKy", hex: "#87CEEB" },
                { name: "ghost white", hex: "#F8F8FF" }, { name: "Amethyst", hex: "#9966CC" }
            ]}
        ];

        // --- COMPONENTS ---

        const ColorCard = ({ color }) => {
            const [copied, setCopied] = useState(false);
            const textColor = getOptimalTextColor(color.hex);
            
            const handleCopy = () => {
                copyToClipboard(color.hex);
                setCopied(true);
                setTimeout(() => setCopied(false), 1500);
            };

            return (
                <div 
                    onClick={handleCopy}
                    className="color-card group relative h-28 w-full rounded-xl cursor-pointer flex flex-col justify-between p-3 border border-black/5 dark:border-white/10"
                    style={{ backgroundColor: color.hex, color: textColor }}
                    role="button"
                    tabIndex={0}
                    aria-label={`Copy ${color.name} hex code`}
                    onKeyDown={(e) => e.key === 'Enter' && handleCopy()}
                >
                    <div className="flex justify-between items-start w-full">
                        <span className="text-[11px] font-bold tracking-tight uppercase opacity-90 drop-shadow-sm leading-tight max-w-[80%]">
                            {color.name}
                        </span>
                        <div className={`opacity-0 group-hover:opacity-100 transition-opacity bg-black/10 dark:bg-white/20 p-1 rounded backdrop-blur-sm`}>
                            {copied ? <Icon name="check" size={14} /> : <Icon name="copy" size={14} />}
                        </div>
                    </div>
                    
                    <div className="flex justify-between items-end w-full">
                        <span className="text-sm font-mono tracking-wider font-semibold opacity-90">{color.hex}</span>
                    </div>
                    
                    {/* Copy indicator overlay */}
                    {copied && (
                        <div className="absolute inset-0 flex items-center justify-center bg-black/20 dark:bg-white/20 backdrop-blur-sm rounded-xl z-20">
                            <span className="font-bold text-xs tracking-widest uppercase">Copied</span>
                        </div>
                    )}
                </div>
            );
        };

        const App = () => {
            const [isDark, setIsDark] = useState(false);
            const [search, setSearch] = useState('');

            // Initialize Lenis Smooth Scrolling
            useEffect(() => {
                if (window.Lenis) {
                    const lenis = new window.Lenis();
                    function raf(time) {
                        lenis.raf(time);
                        requestAnimationFrame(raf);
                    }
                    requestAnimationFrame(raf);
                    return () => lenis.destroy();
                }
            }, []);

            // Handle Intersection Pattern Toggle (Dark/Light)
            const toggleTheme = () => {
                setIsDark(!isDark);
                if (!isDark) document.documentElement.classList.add('dark');
                else document.documentElement.classList.remove('dark');
            };

            // Filter logic
            const filteredData = useMemo(() => {
                if (!search) return colorData;
                return colorData.map(group => ({
                    ...group,
                    colors: group.colors.filter(c => 
                        c.name.toLowerCase().includes(search.toLowerCase()) || 
                        c.hex.toLowerCase().includes(search.toLowerCase())
                    )
                })).filter(group => group.colors.length > 0);
            }, [search]);

            const totalColors = colorData.reduce((acc, g) => acc + g.colors.length, 0);
            const filteredTotal = filteredData.reduce((acc, g) => acc + g.colors.length, 0);

            return (
                <div className="min-h-screen pb-20 selection:bg-emerald-500 selection:text-white">
                    {/* HEADER */}
                    <header className="sticky top-0 z-50 bg-[#F0F2F5]/80 dark:bg-[#0A0A0A]/80 backdrop-blur-md border-b border-gray-200 dark:border-white/10 shadow-sm">
                        <div className="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
                            <div className="flex items-center gap-3">
                                <div className="w-8 h-8 bg-emerald-600 rounded flex items-center justify-center text-white font-bold text-sm shadow-inner">
                                    CM
                                </div>
                                <div>
                                    <h1 className="text-sm font-bold tracking-tight">Color Matrix Validator</h1>
                                    <p className="text-[10px] text-gray-500 dark:text-gray-400 font-mono uppercase tracking-widest">Palantir-Grade Token Checker</p>
                                </div>
                            </div>

                            <div className="flex items-center gap-4">
                                <div className="relative hidden md:block">
                                    <input 
                                        type="text" 
                                        placeholder="Filter colors or hex..." 
                                        value={search}
                                        onChange={(e) => setSearch(e.target.value)}
                                        className="text-xs bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-md py-1.5 pl-3 pr-8 w-48 focus:outline-none focus:border-emerald-500 transition-colors"
                                    />
                                    <div className="absolute right-2 top-1.5 text-gray-400"><Icon name="search" size={14} /></div>
                                </div>
                                
                                <div className="h-4 w-px bg-gray-300 dark:bg-gray-700"></div>

                                {/* Intersection Pattern Toggle */}
                                <button 
                                    onClick={toggleTheme}
                                    className="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500 overflow-hidden relative w-10 h-10 flex items-center justify-center"
                                    aria-label="Toggle Dark Mode"
                                >
                                    <div className={`toggle-icon absolute ${isDark ? 'rotated opacity-0 scale-50' : 'opacity-100 scale-100'}`}>
                                        <Icon name="moon" size={18} />
                                    </div>
                                    <div className={`toggle-icon absolute ${isDark ? 'opacity-100 scale-100' : 'rotated opacity-0 scale-50'}`}>
                                        <Icon name="sun" size={18} />
                                    </div>
                                </button>
                            </div>
                        </div>
                    </header>

                    {/* MAIN CONTENT */}
                    <main className="max-w-7xl mx-auto px-6 pt-8">
                        
                        {/* Executive Summary Card */}
                        <div className="bg-white dark:bg-gray-900 rounded-xl p-6 shadow-apple mb-8 border border-gray-100 dark:border-gray-800 flex flex-col md:flex-row gap-6 justify-between items-start md:items-center">
                            <div className="max-w-2xl">
                                <h2 className="text-lg font-bold mb-2">Matrix Audit Report</h2>
                                <p className="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                                    You have submitted <span className="font-bold text-black dark:text-white">{totalColors}</span> unstructured color definitions. 
                                    This engine has mathematically approximated their hex values and dynamically calculated the WCAG-compliant text contrast (black vs. white) for each token. Review the grid below to identify cognitive overload. Click any token to copy its hex.
                                </p>
                            </div>
                            <div className="flex flex-col items-end shrink-0">
                                <div className="text-3xl font-bold tracking-tighter">{filteredTotal}</div>
                                <div className="text-xs font-mono uppercase tracking-widest text-gray-500">Tokens Visible</div>
                            </div>
                        </div>

                        {/* GRID LAYOUT */}
                        <div className="space-y-12">
                            {filteredData.map((group, idx) => (
                                <section key={idx} className="animate-fade-in">
                                    <div className="flex items-center gap-3 mb-4">
                                        <h3 className="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400">{group.group}</h3>
                                        <div className="h-px flex-1 bg-gradient-to-r from-gray-200 dark:from-gray-800 to-transparent"></div>
                                    </div>
                                    
                                    <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
                                        {group.colors.map((color, cIdx) => (
                                            <ColorCard key={cIdx} color={color} />
                                        ))}
                                    </div>
                                </section>
                            ))}
                            
                            {filteredData.length === 0 && (
                                <div className="text-center py-20 text-gray-500 dark:text-gray-400 text-sm">
                                    No colors found matching your filter criteria.
                                </div>
                            )}
                        </div>

                    </main>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
